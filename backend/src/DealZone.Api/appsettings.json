{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DealZoneDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "CorsSettings": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "private-storage/verification-documents"
  },
  "AdminSettings": {
    "SeedAdminEmail": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 5,
    "RegisterPermitLimit": 3,
    "PasswordResetPermitLimit": 3,
    "ResendConfirmationPermitLimit": 3,
    "WindowSeconds": 60
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "DealZone.Api",
    "Audience": "DealZone.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromEmail": "noreply@dealzone.eg",
    "FromName": "DealZone Marketplace"
  },
  "Swagger": {
    "Enabled": false
  }
}
