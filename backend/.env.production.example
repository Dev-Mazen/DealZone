# DealZone Production Environment Configuration Example
# Copy this as a reference when configuring MonsterASP.NET environment variables.
# DO NOT COMMIT ACTUAL PASSWORDS TO SOURCE CONTROL.

# Database Connection (MonsterASP.NET MS SQL Server)
ConnectionStrings__DefaultConnection="Server=mssqlX.monsterasp.net;Database=YOUR_DATABASE_NAME;User Id=YOUR_DB_USER;Password=YOUR_STRONG_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true;"

# JWT Security (Must be at least 32 characters / 256-bit cryptographically secure in Production)
JwtSettings__SecretKey="GENERATE_A_64_CHARACTER_RANDOM_HEX_STRING_FOR_PRODUCTION_SECURITY_2026!"
JwtSettings__Issuer="DealZone.Api"
JwtSettings__Audience="DealZone.Clients"
JwtSettings__AccessTokenExpirationMinutes="60"
JwtSettings__RefreshTokenExpirationDays="30"

# CORS Policy (Set to your exact Vercel frontend URL)
CorsSettings__AllowedOrigins__0="https://dealzone.vercel.app"

# Application Environment
ASPNETCORE_ENVIRONMENT="Production"

# Rate Limiting
RateLimiting__Enabled="true"
RateLimiting__LoginPermitLimit="10"
RateLimiting__RegisterPermitLimit="5"

# Optional Initial Platform Admin Setup
AdminSettings__SeedAdminEmail="admin@dealzone.eg"

# File Storage
FileStorage__RootPath="private-storage/verification-documents"
