# Root .gitignore for DealZone Monorepo

# ── Dependencies ──
node_modules/
*/node_modules/
frontend/node_modules/

# ── Build & Publish Outputs ──
bin/
obj/
backend/**/bin/
backend/**/obj/
backend/publish/
publish/
dist/
frontend/dist/
frontend/dist-ssr/
frontend/.output/

# ── Local Storage & Uploads ──
backend/private-storage/
private-storage/
*.mdf
*.ldf
*.ndf

# ── Vite / Frontend Cache ──
.vite/
frontend/.vite/
frontend/coverage/

# ── Environment & Secret Files ──
.env
.env.local
.env.*.local
*.local
frontend/.env.local
frontend/.env.*.local

# ── Logs & Temporary Files ──
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE & Editor Specific ──
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp
*.swo
.DS_Store
Thumbs.db
